# Left out of every download (GitHub's Download ZIP, release archives, git archive): a download holds the extension
# folder and the license. A clone still has everything, for working on Lighthouse.
/README.md export-ignore
/CHANGELOG.md export-ignore
/docs export-ignore
/scripts export-ignore
/tests export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
